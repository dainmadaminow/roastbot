# ===== Обязательные настройки =====

# Токен от @BotFather (выглядит как 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Ключ AI API
AI_API_KEY=

# ===== AI =====

# Адрес API. OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# DeepSeek: https://api.deepseek.com
AI_BASE_URL=https://api.openai.com/v1

# Название модели (смотрите в документации вашего провайдера)
AI_MODEL=gpt-4o-mini

# Креативность: 0.0 — сухо, 1.0 — бодро, 1.3 — совсем безумно
AI_TEMPERATURE=1.0

# Максимальная длина ответа ИИ в токенах
AI_MAX_TOKENS=200

# Сколько секунд ждать ответа ИИ и сколько раз повторять запрос при сбое
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Жёсткий предел длины ответа в символах
MAX_REPLY_CHARS=300

# ===== Контекст =====

# Сколько последних сообщений каждой группы помнить (включая ответы бота)
MAX_CONTEXT_MESSAGES=20

# Каждое сообщение в контексте обрезается до такого числа символов
MAX_MESSAGE_CHARS=500

# ===== Очередь и задержки =====

# Случайная пауза перед ответом (секунды)
MIN_DELAY_SECONDS=1
MAX_DELAY_SECONDS=3

# Сколько запросов к ИИ можно делать одновременно (по всем группам)
MAX_CONCURRENT_REQUESTS=3

# Сколько сообщений одной группы может ждать в очереди; лишние пропускаются
CHAT_QUEUE_SIZE=20

# Сообщения, которые ждали дольше этого (секунды), пропускаются как устаревшие
MAX_JOB_AGE_SECONDS=90

# ===== Прочее =====

# true — /on и /off могут использовать только админы группы
ADMIN_ONLY_TOGGLE=false

# Файл с характером бота и файл состояния (/on, /off)
PERSONALITY_FILE=personality.txt
STATE_FILE=data/state.json

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO